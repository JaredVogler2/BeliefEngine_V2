{
  "name": "belief-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Belief Engine - a browser strategy roguelite where shared belief rewrites the physical laws of a village.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "size": "tsx scripts/check-bundle.ts",
    "verify:hosting": "tsx scripts/verify-hosting.ts",
    "profile": "tsx scripts/profile-ui.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"mcp/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:browsers": "BE_CROSS_BROWSER=1 playwright test tests/e2e/smoke.spec.ts --project=desktop --project=firefox --project=webkit --project=iphone",
    "test:sim": "tsx scripts/tournament.ts",
    "test:sim:smoke": "tsx scripts/tournament.ts --smoke",
    "mcp": "tsx mcp/server.ts",
    "gen:verify": "tsx scripts/verify-expeditions.ts --from 1 --to 1000 --catalog",
    "mcp:demo": "tsx mcp/agent-demo.ts",
    "mcp:verify": "tsx mcp/verify-run.ts",
    "replay:example": "tsx scripts/replay-example.ts",
    "nl:corpus": "tsx scripts/nl-corpus.ts",
    "nl:demo": "tsx scripts/nl-demo.ts",
    "acceptance:mcp": "tsx scripts/acceptance-b.ts",
    "acceptance:fun": "tsx scripts/acceptance-fun.ts",
    "acceptance:novice": "tsx scripts/novice-pass.ts",
    "monkey": "tsx scripts/monkey.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
