# Belief Engine V2: server-side settings for online reading. NAMES ONLY: never put a value in this file.
# Put real values in an untracked .env.local (local development) or in the Vercel project's environment settings.
# Without any of these the game works fully offline and the online routes answer "not configured". See docs/AI_SETUP.md.

# Master switch: 1 turns the online routes on (anything else keeps them off)
BE_AI_ENABLED=

# Gateway credential for LOCAL development only. On Vercel, leave it unset: the deployment's OIDC token is used.
AI_GATEWAY_API_KEY=

# Optional model ids from the AI Gateway catalog (defaults in server/ai/config.ts, prices in docs/AI_COSTS.md)
BE_AI_MODEL_FAST=
BE_AI_MODEL_ACCURATE=

# Signs the short-lived session tokens: 32 or more random characters (e.g. `openssl rand -base64 48`)
BE_SESSION_SECRET=

# Browser origins allowed to open sessions, comma-separated and exact, e.g. https://your-project.vercel.app
BE_ALLOWED_ORIGINS=

# Durable shared quota store: Upstash Redis REST URL and token (the Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Application spend cap per UTC day in US dollars (default 1) and project-wide call cap per day (default 3000)
BE_AI_DAILY_BUDGET_USD=
BE_AI_CALLS_PER_DAY=

# Operator token for GET /api/ai-metrics (32+ characters); without it the route answers 404
BE_ADMIN_TOKEN=

# Local development only (refused on Vercel): the per-process memory store, and the scripted provider that runs no model
BE_AI_DEV_MEMORY_STORE=
BE_AI_DEV_PROVIDER=
